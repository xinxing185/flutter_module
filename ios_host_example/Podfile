platform :ios, '13.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
module_path = File.expand_path('..', __dir__)
load File.join(module_path, '.ios', 'Flutter', 'podhelper.rb')

target 'MockHost' do
  use_frameworks!
  install_all_flutter_pods(module_path)
  pod 'CudyFlutter', :path => 'CudyFlutter'
end

post_install do |installer|
  flutter_post_install(installer)
end
